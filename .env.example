# Copy this file to ".env" (same folder) and fill it in. Never commit .env.
#
# Alert emails. For Gmail: turn on 2-step verification, then create an
# "App password" (Google Account > Security > App passwords) and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.team.email@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
ALERT_FROM=your.team.email@gmail.com

# DEMO SAFETY: every alert goes here (your team's own inbox), never to a real government address.
ALERT_TO=your.team.email@gmail.com

# External chat transfers citizen messages to the configured provider. Disabled by default.
# Set to 1 only after choosing an appropriate provider and telling users where their text goes.
SHIELD_EXTERNAL_CHAT_ENABLED=0
